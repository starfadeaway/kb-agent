# ===== LLM =====
# 聊天基座之一。两者都配则前端下拉可切；只配 DeepSeek 则不可切。
# 默认基座是 DeepSeek：实验 E 实测质量与 MiniMax 打平(p=0.639)，
# 但延迟快 2.97x(p<0.0001)且无额度中断。见 EVALUATION.md 实验 E。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 备用聊天基座(实验 E 的对照组)。国内直连 api.minimax.chat 可能不通，
# 可换成国内站 https://api.minimaxi.com/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_CHAT_MODEL=MiniMax-M2.5
# 仅当要用 MiniMax 做 embedding 实验时才需要这两个；
# 默认索引用 BAAI/bge-m3，dim 必须是 1024。
MINIMAX_EMBED_MODEL=embo-01
MINIMAX_EMBED_DIM=1536

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Embedding(实验组)
# 维度不是配置项，是运行时探测出来的（LLMClient.embed_dim 实际打一次 embedding 接口）。
# 所以这里没有 EMBED_DIM —— 写上去也不生效。bge-m3 实测是 1024 维。
EMBED_MODEL_MAIN=BAAI/bge-m3
EMBED_MODEL_ALT=embo-01

# Rerank(注意:仅用于 bge 系向量模型,embedding 对比实验须关闭)
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Judge 模型(必须与被测模型不同源,避免 self-preference bias)
JUDGE_MODEL=Qwen/Qwen3-8B
JUDGE_BASE_URL=https://api.siliconflow.cn/v1

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=kb_agent
# MySQL 只用于存会话/反馈等结构化数据；它不通不影响问答主链路。
# 本机默认用 sqlite，见 backend/app/store 下各 store 的降级分支。
MYSQL_REQUIRED=false

# ===== 向量库 =====
# VECTOR_BACKEND: lancedb(默认,真实向量库) | numpy(零依赖精确索引) | sqlite(最小演示)
# 下面这个路径本身不再存向量，它只用来定位同级目录：
#   <CHROMA_PATH 的上级>/lance/    → LanceDB 表
#   <CHROMA_PATH 的上级>/vectors/  → numpy 索引
# 名字里留着 chroma 是历史遗留，不是还在用 Chroma。
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION_PREFIX=kb
VECTOR_BACKEND=lancedb
# ANN 近似索引默认关闭：LanceDB 0.40 的 create_index(cosine) 已废弃，
# 建的是 IVF-PQ 会把向量量化，实测会改变 top-3 排名。评测必须可复现。
VECTOR_ANN=false

# ===== 游戏数据源 =====
WIKI_BASE=https://wiki.biligame.com
# 已收录的游戏。slug 对应 wiki.biligame.com/<slug>：
#   sr=崩坏：星穹铁道  zzz=绝区零  ys=原神
# 三个都要先跑 scripts/crawl_all.py 建库，否则 /api/health 里没有它，
# 问到它会走"知识库未收录"而不是编答案。
GAME_PRIMARY=sr
GAME_SECONDARY=zzz
GAME_TERTIARY=ys
# EdgeOne 限流：请求最小间隔(秒)
# 实测一次 titles=A|B|C 批量取 10 页 + 间隔 6s + Cookie 保持 = 968 页 0 次拦截。
# 调小这个值会开始收到 567(限流挑战页)。
WIKI_MIN_INTERVAL=6.0
WIKI_MAX_RETRY=4

# ===== Agent 预算与安全阀 =====
AGENT_MAX_STEPS=8
AGENT_TOKEN_BUDGET=60000
AGENT_WALL_TIMEOUT=60
TOOL_TIMEOUT=15
CONCURRENCY_LIMIT=4
# 逗号分隔的启用工具；留空或填 all = 全部四个。
# 默认只给 search_kb，这是实验 C 的结论：C1(仅 search_kb) 4.60 vs C2(全工具) 4.47，
# p=0.47 未达显著 —— 多挂 3 个工具没有可测收益，却要多付 22.6% token。
# 想复现实验 C 的 C2 档就改成 search_kb,get_page,calculator,list_games
AGENT_TOOLS=search_kb

# Chat 降级链：主基座遇到 429 / 5xx / 超时 / 连接失败时，依次换用这些基座。
# 留空 = 不降级（默认）。填了 minimax 就是 deepseek → minimax。
# 只对**可重试**故障生效：400 参数错、401 鉴权错、内容过滤一律不重试 ——
# 同样的请求再发一次还是会失败，重试只是把延迟和账单翻倍。
# 降级会在 /api/health 的 fallback 段留痕，也会出现在 /api/chat 响应的
# fallback 字段里 —— 降级不报错，所以必须让它自己显形。
CHAT_FALLBACKS=
CHAT_FALLBACK_BACKOFF=0.8

# ===== 检索 =====
RETRIEVE_TOP_K=5
RETRIEVE_CANDIDATE=20
RRF_K=60
CHUNK_SIZE=500
CHUNK_OVERLAP=50
